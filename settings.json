{
 "mirror": "https://rsshub.rssforever.com",
 "wechat_mirror": "",
 "rsshub_timeout": 45,
 "proxy": null,
 "llm": {
  "concurrency": 3,
  "providers": [
   {
    "name": "glm",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
    "key_file": "digest/glm_api_key.txt",
    "key_env": "GLM_API_KEY",
    "models": [
     "glm-4.5-flash"
    ],
    "temperature": 0.3,
    "max_tokens": 600,
    "note": "glm-4.5-flash 独占：glm-4.7-flash 是推理模型，思考会吃掉输出预算导致批量摘要被截断，不再作为备胎",
    "batch_timeout": 240,
    "batch_max_tokens": 8000
   },
   {
    "name": "modelscope",
    "base_url": "https://api-inference.modelscope.cn/v1/chat/completions",
    "key_file": "digest/ms_api_key.txt",
    "key_env": "MODELSCOPE_API_KEY",
    "models": [
     "ZhipuAI/GLM-4.7-Flash",
     "Qwen/Qwen3.8-Flash-Next"
    ],
    "temperature": 0.3,
    "max_tokens": 600,
    "note": "魔搭 API Inference：访问令牌需绑定阿里云账号并完成实名认证+邮箱验证（Magicubes 仅对验证账户开放，已验证可用）；免费层按魔粒计费：每日登录200粒+绑定阿里云50粒=250粒（当日有效），验证邮箱等一次性奖励50粒长期魔粒；API 调用轻量0.5/主流1/旗舰2粒每次",
    "batch_timeout": 240,
    "batch_max_tokens": 8000
   },
   {
    "name": "deepseek",
    "base_url": "https://api.deepseek.com/v1/chat/completions",
    "key_file": "digest/deepseek_api_key.txt",
    "key_env": "DEEPSEEK_API_KEY",
    "models": [
     "deepseek-chat"
    ],
    "temperature": 0.3,
    "max_tokens": 600,
    "note": "付费备胎，约¥1-4/天",
    "batch_timeout": 240,
    "batch_max_tokens": 8000
   },
   {
    "name": "siliconflow",
    "base_url": "https://api.siliconflow.cn/v1/chat/completions",
    "key_file": "digest/siliconflow_api_key.txt",
    "key_env": "SILICONFLOW_API_KEY",
    "models": [
     "Qwen/Qwen3-8B",
     "THUDM/GLM-4-9B-0414"
    ],
    "temperature": 0.3,
    "max_tokens": 600,
    "note": "硅基流动，部分小模型免费",
    "batch_timeout": 240,
    "batch_max_tokens": 8000
   }
  ],
  "min_interval_seconds": 15,
  "batch_size": 4,
  "repair_max": 12,
  "debug_batch_dump": true,
  "cooldown_seconds": 30,
  "max_minutes": 30
 },
 "window_days": 1,
 "per_source_daily_cap": 4,
 "items_per_module_cap": 16,
 "dedupe_threshold": 0.72,
 "summary_chars": 300,
 "rerank_keyword_weight": 0.3,
 "rerank_importance_weight": 2.0,
 "article_text_chars": 1200,
 "lead_enough_chars": 180,
 "source_concurrency": 6,
 "article_concurrency": 6,
 "politeness_sleep": 0.3,
 "http_timeout": 25,
 "out_dir": "output",
 "data_dir": "data",
 "log_dir": "logs",
 "date_only_grace_hours": 20
}